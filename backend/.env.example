# Copy to .env. Generate the three secrets with:
#   python3 scripts/generate_secrets.py >> .env

# Used when running the API on your machine. Inside docker compose this is overridden.
DATABASE_URL=postgresql+psycopg://sip:sip@localhost:5433/sip

JWT_EXPIRE_MINUTES=60

# Comma-separated browser origins allowed to call the API (the Flutter web dev server).
CORS_ORIGINS=http://localhost:3000

# Secrets, appended by scripts/generate_secrets.py:
# JWT_SECRET=
# DATA_ENCRYPTION_KEY=   32 random bytes, base64. Losing it makes encrypted data unreadable.
# EMAIL_HASH_KEY=        32 random bytes, base64. Changing it breaks login for existing users.
